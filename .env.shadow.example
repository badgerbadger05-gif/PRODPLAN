# Copy this file to .env.shadow and run: chmod 600 .env.shadow
# Do not commit .env.shadow. Use at least 24 URL-safe random characters.
PRODPLAN_SHADOW_POSTGRES_PASSWORD=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARS
# Shared only with trusted operators calling /item-ledger/admin.
ITEM_LEDGER_ADMIN_TOKEN=REPLACE_WITH_UNIQUE_ADMIN_TOKEN

PRODPLAN_SHADOW_POSTGRES_DB=prodplan_shadow
PRODPLAN_SHADOW_POSTGRES_USER=prodplan_shadow
PRODPLAN_SHADOW_POSTGRES_HOST_PORT=55434
PRODPLAN_SHADOW_BACKEND_PORT=8020
PRODPLAN_SHADOW_GREEN_PORT=18020
PRODPLAN_SHADOW_FRONTEND_PORT=9020
PRODPLAN_SHADOW_BIND_ADDRESS=0.0.0.0

# Reviewed local runtime images. Start/verify compare every stable tag with its
# exact local image ID; backend and worker also require the source revision
# label. The frontend ID is the exact image serving the retained live assets.
PRODPLAN_BACKEND_GREEN_IMAGE=prodplan-shadow-backend:b38f4dc5
PRODPLAN_BACKEND_GREEN_EXPECTED_IMAGE_ID=sha256:dc8b753687e6dbfde1357cf74d5f6f95797ddabd75d883214017b80d7dd1aaeb
PRODPLAN_BACKEND_GREEN_REVISION=b38f4dc571c6deea512df83528684cd6a39a1cd0
PRODPLAN_SYNC_WORKER_IMAGE=prodplan-shadow-sync-worker:b38f4dc5
PRODPLAN_SYNC_WORKER_EXPECTED_IMAGE_ID=sha256:dc8b753687e6dbfde1357cf74d5f6f95797ddabd75d883214017b80d7dd1aaeb
PRODPLAN_SYNC_WORKER_REVISION=b38f4dc571c6deea512df83528684cd6a39a1cd0
PRODPLAN_FRONTEND_IMAGE=prodplan-shadow-frontend:caf967e5
PRODPLAN_FRONTEND_EXPECTED_IMAGE_ID=sha256:caf967e558367c2152dc87a6497daa0b89451742f311bf1f33289ac3c193119b
PRODPLAN_BACKEND_ROLLBACK_IMAGE=prodplan-shadow-backend:688c18b8
PRODPLAN_FRONTEND_NGINX_CONFIG=./config-shadow/nginx/default.conf
# Dedicated 9-digit band for shadow-created stock-transfer numbers.
PRODPLAN_MATERIAL_ISSUE_NUMBER_OFFSET=100000000

# Slow, staggered background cadence. Workers remain off until their compose
# profile is explicitly enabled.
PRODPLAN_SHADOW_SYNC_TICK_INTERVAL_SECONDS=300
PRODPLAN_SHADOW_SYNC_STARTUP_DELAY_SECONDS=180
PRODPLAN_SHADOW_RECONCILE_INTERVAL_SECONDS=21600
PRODPLAN_SHADOW_RECONCILE_STARTUP_DELAY_SECONDS=900

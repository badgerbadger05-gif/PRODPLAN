# Copy this file to .env.shadow and run: chmod 600 .env.shadow
# Do not commit .env.shadow. Use at least 24 URL-safe random characters.
PRODPLAN_SHADOW_POSTGRES_PASSWORD=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARS
# Shared only with trusted operators calling /item-ledger/admin.
ITEM_LEDGER_ADMIN_TOKEN=REPLACE_WITH_UNIQUE_ADMIN_TOKEN

PRODPLAN_SHADOW_POSTGRES_DB=prodplan_shadow
PRODPLAN_SHADOW_POSTGRES_USER=prodplan_shadow
PRODPLAN_SHADOW_POSTGRES_HOST_PORT=55434
PRODPLAN_SHADOW_BACKEND_PORT=8020
PRODPLAN_SHADOW_FRONTEND_PORT=9020
PRODPLAN_SHADOW_BIND_ADDRESS=0.0.0.0
# Dedicated 9-digit band for shadow-created stock-transfer numbers.
PRODPLAN_MATERIAL_ISSUE_NUMBER_OFFSET=100000000

# Exact reviewed frontend source. Prefer the frontend copied/merged into the
# release checkout; an absolute path to a separate checkout is also supported.
PRODPLAN_FRONTEND_BUILD_CONTEXT=./frontend-erp-shell
# Full reviewed Git commit containing the frontend source above.
PRODPLAN_FRONTEND_EXPECTED_COMMIT=REPLACE_WITH_40_CHAR_FRONTEND_COMMIT

# Link back to the untouched stable program.
PRODPLAN_STABLE_URL=http://mtzdock.lan:9010
PRODPLAN_STABLE_API_URL=http://mtzdock.lan:8010

# Slow, staggered background cadence. Workers remain off until their compose
# profile is explicitly enabled.
PRODPLAN_SHADOW_SYNC_TICK_INTERVAL_SECONDS=300
PRODPLAN_SHADOW_SYNC_STARTUP_DELAY_SECONDS=180
PRODPLAN_SHADOW_RECONCILE_INTERVAL_SECONDS=21600
PRODPLAN_SHADOW_RECONCILE_STARTUP_DELAY_SECONDS=900
